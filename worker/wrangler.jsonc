{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eggx-push",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ORIGIN": "https://paulfv.github.io",
    "APP_URL": "https://paulfv.github.io/EggX/",
    "VAPID_SUBJECT": "https://paulfv.github.io/EggX/"
  },
  "durable_objects": {
    "bindings": [
      { "name": "TIMER_DEVICE", "class_name": "TimerDevice" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TimerDevice"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
